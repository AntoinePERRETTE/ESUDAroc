        "name": "bacnet_client_ExceptionWrite",
        "func": "const client = new bacnet.default({\n    apduTimeout: 5000,\n    interface: '0.0.0.0',\n    port: 47811\n});\n\nconst targetIp = '192.168.140.24';\nconst target = { address: targetIp, net: 0, port: 47808 };\n\n// ── Schedule 0 ──────────────────────────────────────────\n// ── Schedule 0 ──────────────────────────────────────────\nconst exceptionSchedule0 = [{\n    date: {\n        type: 10, // 10 = Date (format BACnet)\n        // Date d'aujourd'hui : 2 Avril 2026\n        // year = 2026 - 1900 = 126, month = 4 (Avril), day = 2\n        value: { year: 126, month: 11, day: 2, wday: 255 }\n    },\n    events: [\n        {\n            // Date JS : le mois 3 correspond à Avril !\n            // Heure : 10h48 et 0 seconde\n            time: new Date(2026, 3, 2, 13, 3, 0),\n            value: { type: 4, value: 10.0 } // PV = 10.0\n        }\n    ],\n    priority: 16 // Toujours garder la priorité interne (1-16)\n} , {\n    date: {\n        type: 10, // 10 = Date (format BACnet)\n        // Date d'aujourd'hui : 2 Avril 2026\n        // year = 2026 - 1900 = 126, month = 4 (Avril), day = 2\n        value: { year: 126, month: 2, day: 2, wday: 255 }\n    },\n    events: [\n        {\n            // Date JS : le mois 3 correspond à Avril !\n            // Heure : 10h48 et 0 seconde\n            time: new Date(2026, 3, 2, 13, 3, 0),\n            value: { type: 4, value: 20.0 } // PV = 10.0\n        }\n    ],\n    priority: 16 // Toujours garder la priorité interne (1-16)\n}, {\n    date: {\n        type: 10, // 10 = Date (format BACnet)\n        // Date d'aujourd'hui : 2 Avril 2026\n        // year = 2026 - 1900 = 126, month = 4 (Avril), day = 2\n        value: { year: 126, month: 3, day: 2, wday: 255 }\n    },\n    events: [\n        {\n            // Date JS : le mois 3 correspond à Avril !\n            // Heure : 10h48 et 0 seconde\n            time: new Date(2026, 3, 2, 13, 3, 0),\n            value: { type: 4, value: 30.0 } // PV = 10.0\n        }\n    ],\n    priority: 16 // Toujours garder la priorité interne (1-16)\n} ,{\n    date: {\n        type: 10, // 10 = Date (format BACnet)\n        // Date d'aujourd'hui : 2 Avril 2026\n        // year = 2026 - 1900 = 126, month = 4 (Avril), day = 2\n        value: { year: 126, month: 4, day: 2, wday: 255 }\n    },\n    events: [\n        {\n            // Date JS : le mois 3 correspond à Avril !\n            // Heure : 10h48 et 0 seconde\n            time: new Date(2026, 3, 2, 13, 3, 0),\n            value: { type: 4, value: 40.0 } // PV = 10.0\n        }\n    ],\n    priority: 16 // Toujours garder la priorité interne (1-16)\n}];\n\n\nasync function main() {\n    try {\n        // Écriture Schedule 0\n        await client.writeProperty(\n            target,\n            { type: 17, instance: 0 },  // Schedule 0\n            38, // 38 = Exception_Schedule\n            exceptionSchedule0,\n            { priority: 16 } // Priorité de la commande d'écriture\n        );\n        node.warn('✅ Schedule 0 envoyé');\n\n    } catch (err) {\n        node.error('❌ Erreur : ' + err.message);\n    } finally {\n        setTimeout(() => { client.close(); }, 1000);\n    }\n}\n\nmain();\nreturn null;",

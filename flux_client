    {
        "id": "96104e8f7c51a6bc",
        "type": "function",
        "z": "316db15f9c352dcf",
        "name": "execute service",
        "func": "let client = new bacnet.default({\n    apduTimeout: 2000,\n    broadcastAddress: flow.get('ipBroadcast'),\n    port: 47808,\n});\n\n/* clear console*/\nmsg.payload = [];\nnode.send(msg);\nclient.on('error', (err) => {\n    node.error('Erreur client: ' + err.message);\n    client.close();\n});\n\nlet address;\n\nlet objectType = flow.get('objectType');\nswitch (objectType) {\n    case \"ANALOG_VALUE\":\n        objectType = bacnet.ObjectType.ANALOG_VALUE;\n        break;\n    case \"ANALOG_INPUT\":\n        objectType = bacnet.ObjectType.ANALOG_INPUT;\n        break;\n    case \"ANALOG_OUTPUT\":\n        objectType = bacnet.ObjectType.ANALOG_OUTPUT;\n        break;\n    case \"BINARY_VALUE\":\n        objectType = bacnet.ObjectType.BINARY_VALUE;\n        break;\n    case \"BINARY_INPUT\":\n        objectType = bacnet.ObjectType.BINARY_INPUT;\n        break;\n    case \"BINARY_OUTPUT\":\n        objectType = bacnet.ObjectType.BINARY_OUTPUT;\n        break;\n}\n\nconst targetInstances = flow.get('targetInstances');\nconst targetInstancesString = JSON.stringify(targetInstances, null, 2);\nlet targetInstancesArray = new Array();\nlet j = 0;\n/*this is abominable, but it works*/\nfor (let i = 0; i < targetInstancesString.length; i++) {\n    targetInstancesArray[i] = 0;\n}\nfor (let i = 1; i < targetInstancesString.length - 1; i++) {\n    if ((targetInstancesString[i]) === ',') {\n        j++;\n    } else {\n        targetInstancesArray[j] *= 10;\n        targetInstancesArray[j] += Number(targetInstancesString[i]);\n    }\n}\n\nconst serviceChoice = flow.get('serviceChoice');\n\nlet inputValue = flow.get('inputValue');\n\nlet bacnetValue;\nif (typeof inputValue === \"boolean\") {\n    bacnetValue = {\n        type: bacnet.ApplicationTag.BOOLEAN,\n        value: inputValue\n    };\n} else if (!isNaN(inputValue)) {\n    bacnetValue = {\n        type: bacnet.ApplicationTag.REAL,\n        value: Number(inputValue)\n    };\n}\n\nlet results = [];\ntry {\n    switch (serviceChoice) {\n        /*READ*/\n        case \"serviceRead\":\n            address = {\n                address: flow.get('ip') + \":\" + flow.get('portDest'),\n            };\n            for (let i = 0; i <= j; i++) {\n                const instance = targetInstancesArray[i];\n                const value = await client.readProperty(\n                    address, {\n                        type: objectType,\n                        instance: instance\n                    },\n                    bacnet.PropertyIdentifier.PRESENT_VALUE\n                );\n                let result = {\n                    object: objectType,\n                    instance: instance,\n                    value: value.values[0].value\n                };\n\n                msg.payload = result;\n                results.push(result);\n                node.send(msg);\n            }\n            if(j > 0){\n                msg.payload ={status : \"✅ multiple read sucessful\"} ;\n            }\n            else{\n                msg.payload ={status :\"✅ read sucessful\"} ;\n            }\n\n            node.send(msg);\n         \n        break;\n            /*WRITE*/\n        case \"serviceWrite\":\n            address = {\n                address: flow.get('ip') + \":\" + flow.get('portDest'),\n            };\n            if (j > 0) {\n                /* multiple write */\n                const requestArray = [];\n                for (let i = 0; i <= j; i++) {\n                    const instance = targetInstancesArray[i];\n                    requestArray.push({\n                        objectId: {\n                            type: objectType,\n                            instance: instance\n                        },\n                        values: [{\n                            property: {\n                                id: bacnet.PropertyIdentifier.PRESENT_VALUE\n                            },\n                            value: [{\n                                type: bacnetValue.type,\n                                value: bacnetValue.value\n                            }],\n                            priority: 8\n                        }]\n                    });\n                }\n\n                await client.writePropertyMultiple(\n                    address,\n                    requestArray\n                );\n\n\n\n                msg.payload = { status: \"✅ multiple write sucessful\"};\n                node.send(msg);\n            }\n            /* single write*/\n            else {\n\n                const instance = targetInstancesArray[0];\n                await client.writeProperty(\n                    address, {\n                        type: objectType,\n                        instance: instance\n                    },\n                    bacnet.PropertyIdentifier.PRESENT_VALUE,\n                    [{\n                        type: bacnetValue.type,\n                        value: bacnetValue.value\n                    }], {\n                        priority: 8\n                    }\n                );\n                let result = {\n                    object: objectType,\n                    instance: instance,\n                    writtenValue: inputValue\n                };\n                results.push(result);\n                node.send(msg);\n                msg.payload = { status: \"✅ write sucessful\" };\n                node.send(msg);\n               \n            }\n\n        break;\n        /*WHOIS*/\n        case \"whoIs\":\n            const discoveryMs = 1000;\n            results = [];\n\n            const onIAm = (device) => {\n                const sender = device.header.sender.address;\n                const deviceId = device.payload.deviceId;\n\n                results.push({\n                    deviceId: deviceId,\n                    address: sender\n                });\n\n                node.warn(`Am reçu: ${deviceId} address : ${sender}`);\n            };\n\n            client.on('iAm', onIAm);\n\n            setTimeout(() => {\n                client.whoIs({\n                    address: flow.get('ipBroadcast')\n                });\n                node.warn(\"whoIs broadcast sent\");\n            }, 500);\n\n            setTimeout(() => {\n                client.removeListener('iAm', onIAm);\n                msg.payload = results;\n                node.send(msg);\n                msg.payload = { status: \"✅ who-is sucessful\" };\n                node.send(msg);\n                client.close();\n            }, discoveryMs);\n\n            return;\n    }\n}\ncatch (err) {\n    node.error(\"Erreur BACnet: \" + err);\n    msg.payload = {status : \"❌\" + err.message };\n    return msg;\n}\nclient.close();\n",

        "z": "316db15f9c352dcf",
        "name": "build ip ",
        "func": "flow.set('ip', msg.payload);\n\nfunction getBroadcastAddress(ip, mask) {\n    const isValid = str => str.split('.').every(n => n >= 0 && n <= 255);\n\n    if (!isValid(ip) || !isValid(mask)) {\n        throw new Error(\"IP ou masque invalide\");\n    }\n\n    const ipParts = ip.split('.').map(Number);\n    const maskParts = mask.split('.').map(Number);\n\n    return ipParts.map((ipPart, i) =>\n        (ipPart & maskParts[i]) | (~maskParts[i] & 255)\n    ).join('.');\n}\n\nconst ipBroadcast = getBroadcastAddress(msg.payload,\"255.255.255.000\");\nflow.set('ipBroadcast', ipBroadcast);\n\n",

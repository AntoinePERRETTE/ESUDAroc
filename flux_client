        "func": "const client = new bacnet.default({ apduTimeout: 10000, broadcastAddress: flow.get('ipBroadcast') });\n\n\nclient.on('error', (err) => {\n    node.error('Erreur client: ' + err.message);\n    client.close();\n});\n\nconst address = flow.get('ip') + \":\" + flow.get('port');\nconst request =\n{\n    objectId: {\n        type: bacnet.ObjectType.ANALOG_VALUE,\n        instance: 10\n    },\n    values: [\n        {\n            property: {\n                id: bacnet.PropertyIdentifier.PRESENT_VALUE, index : 10\n            },\n            value:\n                [\n                    {\n                        type: 4, /*bacnet.ApplicationTag.REAL*/\n                        value: 29\n                    }\n                ],\n            priority: 16\n        }\n    ]\n};\nasync function main() {\n    try {\n\n       \n        \n       \n        await client.writePropertyMultiple\n        (\n            address,\n           request\n        );\n        node.warn(request);\n        node.warn('Écriture EXCEPTION_SCHEDULE réussie');\n        node.send({ payload: 'OK' });\n    } catch (err) {\n        node.error('Exception: ' + JSON.stringify(err, Object.getOwnPropertyNames(err)));\n        client.close();\n    }\n    finally {\n        client.close();\n    }\n}\nnode.warn(\"start multipleWrite\");\nmain();\nreturn null;",

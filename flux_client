        "name": "bacnet_client_scheduleWrite",
        "func": "const client = new bacnet.default({ apduTimeout: 10000, broadcastAddress: flow.get('ipBroadcast') });       \n\nclient.on('error', (err) => {\n    node.error('Erreur client: ' + err.message);\n    client.close();\n});\n\nconst address = { address:flow.get('ip') + \":\" + flow.get('port') };\n\n// Helper pour créer un objet Date avec l'heure souhaitée\nfunction makeTime(hour, minute) {\n    const d = new Date();\n    d.setHours(hour, minute, 0, 0);\n    return d;\n}\n\nconst weeklySchedule = [\n    // Lundi\n    [\n        { time: makeTime(6, 0), value: { type: 4, value: 21.0 } },\n        { time: makeTime(22, 0), value: { type: 4, value: 19.0 } },\n    ],\n    // Mardi\n    [\n        { time: makeTime(6, 0), value: { type: 4, value: 21.0 } },\n        { time: makeTime(22, 0), value: { type: 4, value: 19.0 } },\n    ],\n    // Mercredi\n    [\n        { time: makeTime(6, 0), value: { type: 4, value: 21.0 } },\n        { time: makeTime(22, 0), value: { type: 4, value: 19.0 } },\n    ],\n    // Jeudi\n    [\n        { time: makeTime(6, 0), value: { type: 4, value: 21.0 } },\n        { time: makeTime(22, 0), value: { type: 4, value: 19.0 } },\n    ],\n    // Vendredi\n    [\n        { time: makeTime(6, 0), value: { type: 4, value: 21.0 } },\n        { time: makeTime(22, 0), value: { type: 4, value: 19.0 } },\n    ],\n    // Samedi\n    [],\n    // Dimanche\n    [],\n];\n\nasync function main() {\n    try {\n        await client.writeProperty(\n            address,\n            { type: bacnet.ObjectType.SCHEDULE, instance: 1 },\n            bacnet.PropertyIdentifier.WEEKLY_SCHEDULE,\n            weeklySchedule,\n            { priority: 16 }\n        );\n\n        node.warn('Écriture WEEKLY_SCHEDULE réussie');\n        node.send({ payload: 'OK' });\n\n    } catch (err) {\n        node.error('Erreur: ' + JSON.stringify(err, Object.getOwnPropertyNames(err)));\n    } finally {\n        client.close();\n    }\n}\n\nmain();\nreturn null;",

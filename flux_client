        "func": "const client = new bacnet.default({ apduTimeout: 4000 });\n\nconst objectInstance = 1;\n\nclient.on('error', (err) => {\n    node.error('Erreur client: ' + err.message);\n    client.close();\n});\n\nconst address = { address: flow.get('ip') + \":\" + flow.get('port') };\n\nasync function main() {\n    try {\n        const value = await client.readProperty(\n            address,\n            { type: bacnet.ObjectType.SCHEDULE, instance: objectInstance },\n            bacnet.PropertyIdentifier.PRESENT_VALUE\n        );\n\n        const result = {\n            object: 'Schedule-present-value',\n            instance: objectInstance,\n            value: value.values[0]?.value\n        };\n\n        node.warn(JSON.stringify(result, null, 2));\n        node.send({ payload: result });\n\n    } catch (err) {\n        node.error('Erreur: ' + JSON.stringify(err, Object.getOwnPropertyNames(err)));\n    }\n}\n\nmain();\nreturn null;",
